# Environment Variables for Netspeak Portal

# Database (Supabase PostgreSQL Connection URL)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netspeak_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/netspeak_db?schema=public"

# Session Security
SESSION_SECRET="replace-with-a-random-64-character-secret-key"

# Gmail SMTP Configuration (For notifications, password resets, verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM="Netspeak Portal <noreply@netspeak.com>"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
